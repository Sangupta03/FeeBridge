# Copy to .env.local and fill in from your Firebase console.
# Leave DATA_SOURCE=local to run the whole app with seeded demo data and no Firebase at all.
VITE_DATA_SOURCE=local

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The school's UPI id, used to build payment QR codes
VITE_SCHOOL_UPI_VPA=greenvalley@okaxis
VITE_SCHOOL_NAME=Green Valley School
