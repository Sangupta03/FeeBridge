rules_version = '2';

// FeeBridge access rules.
// The important one: a parent can only ever read their own family, and risk
// profiles are office-only. Helping people quietly is a security requirement,
// not just a UI choice.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isClerk() { return signedIn() && role() == 'clerk'; }
    function myFamily() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /families/{familyId} {
      allow read: if isAdmin() || isClerk() || (signedIn() && myFamily() == familyId);
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isClerk()
                  || (signedIn() && resource.data.familyId == myFamily());
      allow write: if isAdmin();
    }

    // fee structure isn't tied to one family - any signed-in role can see what's
    // owed, only the office defines it
    match /feeHeads/{feeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isAdmin() || isClerk()
                  || (signedIn() && resource.data.familyId == myFamily());
      allow create, delete: if isAdmin();
      // a matched payment updates the invoice it settles - the office, a clerk
      // taking cash, or the family paying it can all trigger that update
      allow update: if isAdmin() || isClerk()
                    || (signedIn() && resource.data.familyId == myFamily());
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || isClerk()
                  || (signedIn() && resource.data.familyId == myFamily());
      // clerks record cash at the desk; parents can only record their own
      allow create: if isAdmin() || isClerk()
                    || (signedIn() && request.resource.data.familyId == myFamily());
      allow update, delete: if isAdmin();
    }

    match /plans/{planId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.familyId == myFamily());
      allow create, delete: if isAdmin();
      // paying an instalment marks that part paid on the plan itself
      allow update: if isAdmin()
                    || (signedIn() && resource.data.familyId == myFamily());
    }

    // risk scores are never readable by families
    match /riskProfiles/{familyId} {
      allow read: if isAdmin();
      allow write: if false; // written by Cloud Functions only
    }
  }
}
